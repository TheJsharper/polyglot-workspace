{
  "name": "dashboard_remote",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "libs/remotes/dashboard-remote/src",
  "tags": [
    "type:remote"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libs/remotes/dashboard_remote",
        "index": "libs/remotes/dashboard-remote/src/index.html",
        "main": "libs/remotes/dashboard-remote/src/main.ts",
        "tsConfig": "libs/remotes/dashboard-remote/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/remotes/dashboard-remote/public"
          }
        ],
        "styles": [
          "libs/remotes/dashboard-remote/src/styles.scss"
        ],
        "customWebpackConfig": {
          "path": "libs/remotes/dashboard-remote/webpack.config.ts"
        },
        "indexHtmlTransformer": "tools/mf-index-html.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "libs/remotes/dashboard-remote/webpack.prod.config.ts"
          }
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "dependsOn": [
        "lint",
        "^build"
      ]
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4301,
        "publicHost": "http://localhost:4301",
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "dashboard_remote:build:production"
        },
        "development": {
          "buildTarget": "dashboard_remote:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "dashboard_remote:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/libs/remotes/dashboard-remote"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "dashboard_remote:build",
        "port": 4301,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "dashboard_remote:build:development"
        },
        "production": {
          "buildTarget": "dashboard_remote:build:production"
        }
      }
    }
  }
}
