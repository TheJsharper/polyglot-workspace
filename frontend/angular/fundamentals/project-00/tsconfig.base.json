{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@project-00/shells-main": [
        "./libs/shells/main/src/index.ts"
      ],
      "@project-00/layouts-main-layout": [
        "./libs/layouts/main-layout/src/index.ts"
      ],
      "@project-00/shared-ui": [
        "./libs/shared/ui/src/index.ts"
      ],
      "@project-00/services-state": [
        "./libs/services/state/src/index.ts"
      ],
      "@project-00/services-university-state": [
        "./libs/services/university-state/src/index.ts"
      ],
      "@project-00/services-session": [
        "./libs/services/session/src/index.ts"
      ],
      "@project-00/views-university": [
        "./libs/views/university/src/index.ts"
      ],
      "@project-00/services-api": [
        "./libs/services/api/src/index.ts"
      ],
      "@project-00/services-core": [
        "./libs/services/core/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
