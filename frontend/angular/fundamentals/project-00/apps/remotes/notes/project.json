{
  "name": "remote-notes",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/remotes/notes/src",
  "tags": [
    "type:remote"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/remotes/notes/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "remote-notes:esbuild:production"
        },
        "development": {
          "target": "remote-notes:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "continuous": true,
      "options": {
        "target": "remote-notes:serve-original:development",
        "tsConfig": "apps/remotes/notes/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/apps/remotes/notes"
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "dependsOn": [
        "lint",
        "^build"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/remotes/notes",
        "index": "apps/remotes/notes/src/index.html",
        "tsConfig": "apps/remotes/notes/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/remotes/notes/public"
          },
          {
            "glob": "es-module-shims.js",
            "input": "node_modules/es-module-shims/dist",
            "output": "."
          }
        ],
        "styles": [
          "apps/remotes/notes/src/styles.scss"
        ],
        "browser": "apps/remotes/notes/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4305,
        "publicHost": "http://localhost:4305",
        "proxyConfig": "apps/web-app/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "remote-notes:esbuild:production"
        },
        "development": {
          "buildTarget": "remote-notes:esbuild:development"
        }
      }
    }
  }
}
