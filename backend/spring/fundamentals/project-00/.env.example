# Copy to .env (untracked) and fill in real values. Never commit .env.
DB_URL=jdbc:h2:mem:project00;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# At least 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=1h
JWT_ISSUER=project-00
