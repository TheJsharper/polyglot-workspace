# Copy to .env (untracked) and fill in real values. Never commit .env.
DB_URL=jdbc:h2:mem:project00;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=

# Production only: use a managed PostgreSQL URL with TLS and credentials from a secret manager.
# DB_URL=jdbc:postgresql://db.example.com:5432/university?sslmode=require
# DB_USERNAME=university_app
# DB_PASSWORD=replace-with-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# At least 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=15m
JWT_ISSUER=project-00

# Google SSO is disabled until all values are configured. Google callback must be registered in Google Cloud.
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_FRONTEND_URL=http://localhost:4300/sso/callback

# Demo-keys microservice (project-01), dev profile only. The secret must equal SERVICE_AUTH_SECRET in project-01 (min 32 chars).
DEMO_KEYS_SERVICE_URL=http://127.0.0.1:8081
DEMO_KEYS_SERVICE_SECRET=change-me-to-a-long-random-string-shared-with-project-01
